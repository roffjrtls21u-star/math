<script>
const TEACHER_PASS = "gem2026";

let state = {
  grade:null, cls:null, number:null, studentId:null,
  big:null, small:null, expected:null,
  currentCounts:{h:0,t:0,o:0}, lockedGroups:[], groupsShown:0,
  regroup:null
};

const $ = id => document.getElementById(id);
const show = el => el.classList.remove('hidden');
const hide = el => el.classList.add('hidden');

function digits(n){
  return { h: Math.floor(n/100), t: Math.floor(n/10)%10, o: n%10 };
}

/* ---------- GEM PROGRESS ---------- */
function gemSVG(colorSet){
  return `<svg viewBox="0 0 100 100"><polygon points="50,4 90,35 74,96 26,96 10,35" fill="${colorSet[0]}"/><polygon points="50,4 90,35 50,50" fill="${colorSet[1]}"/><polygon points="10,35 50,50 26,96" fill="${colorSet[2]}"/><polygon points="90,35 74,96 50,50" fill="${colorSet[3]}"/></svg>`;
}
function renderGemProgress(step){
  const labels = ['문제 만들기','수모형','세로셈'];
  const active = ['#8B6FD9','#C9B8F5','#6B4FBF','#9B7FE0'];
  const done = ['#FFC857','#FFE1A6','#E8A93A','#FFD57A'];
  const todo = ['#D7D3E8','#EDEAF6','#C2BCDC','#DAD5EE'];
  let html='';
  for(let i=1;i<=3;i++){
    const cls = i===step ? 'active' : '';
    const set = i<step ? done : (i===step ? active : todo);
    html += `<div class="gem-step ${cls}">${gemSVG(set)}<span>${labels[i-1]}</span></div>`;
  }
  $('gem-progress').innerHTML = html;
}

/* ---------- LOGIN ---------- */
$('btn-login').onclick = ()=>{
  const g = parseInt($('in-grade').value), c = parseInt($('in-class').value), n = parseInt($('in-number').value);
  const err = $('login-err');
  if(!g||!c||!n||g<1||g>6||c<1||n<1){
    err.textContent = '학년, 반, 번호를 모두 알맞게 입력해 주세요.';
    return;
  }
  err.textContent='';
  state.grade=g; state.cls=c; state.number=n;
  state.studentId = `${g}-${c}-${n}`;
  hide($('screen-login'));
  show($('app-area'));
  goToStep(1);
};

/* ---------- NAVIGATION ---------- */
function goToStep(step){
  ['screen-1','screen-2','screen-3','screen-done'].forEach(id=>hide($(id)));
  if(step<=3){ renderGemProgress(step); show($('gem-progress')); } else { hide($('gem-progress')); }
  if(step===1){ show($('screen-1')); resetStep1UI(); }
  if(step===2){ show($('screen-2')); buildStep2(); }
  if(step===3){ show($('screen-3')); buildStep3(); }
  if(step==='done') show($('screen-done'));
}

/* ---------- STEP 1 : 일의 자리에서만 올림 있는 문제 랜덤 뽑기 ---------- */
function isOnesOnlyCarry(big, small){
  const d = digits(big);
  const c1 = d.o*small >= 10;
  if(!c1) return false;
  const tensAfter = d.t*small + Math.floor(d.o*small/10);
  const c2 = tensAfter >= 10;
  if(c2) return false;
  const hundredsAfter = d.h*small;
  const c3 = hundredsAfter >= 10;
  if(c3) return false;
  return true;
}
function randomOneCarryProblem(){
  let big, small, tries=0;
  do{
    big = Math.floor(Math.random()*900)+100;
    small = Math.floor(Math.random()*8)+2;
    tries++;
  } while(!isOnesOnlyCarry(big,small) && tries<500);
  return {big, small};
}

let drawTimer = null;
function resetStep1UI(){
  if(drawTimer) clearTimeout(drawTimer);
  $('slot-big').textContent = '( \u00a0\u00a0\u00a0 )';
  $('slot-small').textContent = '( \u00a0 )';
  $('slot-big').className = 'slot-box';
  $('slot-small').className = 'slot-box slot-small';
  $('btn-draw').disabled = false;
  $('btn-draw').textContent = '문제 뽑기 🎲';
  $('btn-step1-next').disabled = true;
  $('step1-err').textContent = '';
  state.big = null; state.small = null; state.expected = null;
}

function startDraw(){
  $('btn-draw').disabled = true;
  $('btn-step1-next').disabled = true;
  $('step1-err').textContent = '';
  const target = randomOneCarryProblem();
  $('slot-big').classList.add('spinning');
  $('slot-small').classList.add('spinning');
  let ticks = 0;
  const maxTicks = 16;
  function tick(){
    if(ticks < maxTicks){
      $('slot-big').textContent = `(${Math.floor(Math.random()*900)+100})`;
      $('slot-small').textContent = `(${Math.floor(Math.random()*8)+2})`;
      ticks++;
      const delay = 45 + ticks*15;
      drawTimer = setTimeout(tick, delay);
    } else {
      $('slot-big').textContent = `(${target.big})`;
      $('slot-small').textContent = `(${target.small})`;
      $('slot-big').className = 'slot-box landed';
      $('slot-small').className = 'slot-box slot-small landed';
      state.big = target.big; state.small = target.small; state.expected = target.big*target.small;
      $('btn-draw').disabled = false;
      $('btn-draw').textContent = '다시 뽑기 🔄';
      $('btn-step1-next').disabled = false;
    }
  }
  tick();
}
$('btn-draw').onclick = startDraw;
$('btn-step1-next').onclick = ()=> goToStep(2);



/* ---------- STEP 2 : drag & drop blocks ---------- */
const BLOCK_LABEL = {h:'백', t:'십', o:'일'};

function blockEl(type){
  const el = document.createElement('div');
  if(type==='h'){ el.className='block-hundred'; }
  else if(type==='t'){ el.className='block-ten'; }
  else { el.className='block-one'; }
  return el;
}

function buildStep2(){
  state.currentCounts = {h:0,t:0,o:0};
  state.lockedGroups = [];
  state.groupsShown = 0;
  state.regroup = null;
  state.finalAnswer = null;
  state.finalCorrect = false;
  state.finalAttempts = 0;
  state.selection = {o:[], t:[], h:[]};

  $('s2-problem').innerHTML = `${state.big} <span class="x">×</span> ${state.small}`;
  $('s2-desc').textContent = `아래 모형을 끌어와서 ${state.big}을(를) 나타내는 한 묶음을 만들어 보세요. '묶음 확인하기'를 눌러 맞으면 다음 묶음이 시작돼요. 이렇게 ${state.small}묶음을 모두 만들면 곱셈이 완성돼요.`;

  $('locked-groups').innerHTML = '';
  $('dropzone').innerHTML = '';
  $('dropzone').classList.add('empty');
  $('hint-msg').textContent = '';
  updateCountsLine();
  updateGroupCounter();

  show($('active-group-area'));
  $('palette').style.opacity='';
  $('palette').style.pointerEvents='';
  hide($('regroup-area'));
  $('regroup-msg').textContent = '';
  updateSelectionHint();
  hide($('final-answer-area'));
  $('in-final-answer').value = '';
  $('in-final-answer').disabled = false;
  $('btn-check-final').disabled = false;
  $('final-feedback').className = 'final-feedback';
  $('final-feedback').textContent = '';
  $('tally-area').innerHTML = '';
  $('btn-step2-next').disabled = true;

  initPaletteDrag();
}

function updateCountsLine(){
  const c = state.currentCounts;
  $('counts-line').textContent = `지금 담은 모형: 백 ${c.h}개 · 십 ${c.t}개 · 일 ${c.o}개`;
}
function updateGroupCounter(){
  $('group-counter').textContent = `${state.groupsShown} / ${state.small} 묶음 완성`;
}

function addBlockToActive(type){
  state.currentCounts[type]++;
  const el = blockEl(type);
  el.classList.add('dz-block');
  el.title = '탭하면 지울 수 있어요';
  el.onclick = ()=>{
    state.currentCounts[type]--;
    el.remove();
    updateCountsLine();
    if(state.currentCounts.h===0 && state.currentCounts.t===0 && state.currentCounts.o===0){
      $('dropzone').classList.add('empty');
    }
  };
  $('dropzone').appendChild(el);
  $('dropzone').classList.remove('empty');
  updateCountsLine();
  $('hint-msg').textContent = '';
}

function initPaletteDrag(){
  document.querySelectorAll('#palette .palette-item').forEach(item=>{
    item.onpointerdown = (e)=>{
      e.preventDefault();
      const type = item.dataset.type;
      const ghost = document.createElement('div');
      ghost.className = 'drag-ghost';
      ghost.appendChild(blockEl(type));
      document.body.appendChild(ghost);
      positionGhost(e);

      function positionGhost(ev){
        ghost.style.left = ev.clientX+'px';
        ghost.style.top = ev.clientY+'px';
      }
      function onMove(ev){ positionGhost(ev); }
      function onUp(ev){
        document.removeEventListener('pointermove', onMove);
        document.removeEventListener('pointerup', onUp);
        const dz = $('dropzone');
        const rect = dz.getBoundingClientRect();
        if(ev.clientX>=rect.left && ev.clientX<=rect.right && ev.clientY>=rect.top && ev.clientY<=rect.bottom){
          addBlockToActive(type);
        }
        ghost.remove();
      }
      document.addEventListener('pointermove', onMove);
      document.addEventListener('pointerup', onUp);
    };
  });
}

$('btn-clear-active').onclick = ()=>{
  state.currentCounts = {h:0,t:0,o:0};
  $('dropzone').innerHTML = '';
  $('dropzone').classList.add('empty');
  updateCountsLine();
  $('hint-msg').textContent = '';
};

function groupBoxHTML(idx, c){
  const hRow = Array(c.h).fill('<div class="block-hundred"></div>').join('');
  const tRow = Array(c.t).fill('<div class="block-ten"></div>').join('');
  const oRow = Array(c.o).fill('<div class="block-one"></div>').join('');
  return `<div class="group-box">
    <div class="g-label">묶음 ${idx}</div>
    <div class="blk-row">${hRow}</div>
    <div class="blk-row">${tRow}</div>
    <div class="blk-row">${oRow}</div>
  </div>`;
}

function mergeAllGroups(){
  const d = digits(state.big);
  const mult = state.small;
  const totalH = d.h*mult, totalT = d.t*mult, totalO = d.o*mult;
  const hRow = Array(totalH).fill('<div class="block-hundred"></div>').join('');
  const tRow = Array(totalT).fill('<div class="block-ten"></div>').join('');
  const oRow = Array(totalO).fill('<div class="block-one"></div>').join('');
  $('locked-groups').innerHTML = `<div class="group-box merged-box">
    <div class="g-label">📦 ${mult}묶음을 모두 모았어요!</div>
    <div class="blk-row" id="merged-th-row"></div>
    <div class="blk-row" id="merged-h-row">${hRow}</div>
    <div class="blk-row" id="merged-t-row">${tRow}</div>
    <div class="blk-row" id="merged-o-row">${oRow}</div>
  </div>`;
}

$('btn-check-group').onclick = ()=>{
  const target = digits(state.big);
  const c = state.currentCounts;
  if(c.h===target.h && c.t===target.t && c.o===target.o){
    state.lockedGroups.push({...c});
    state.groupsShown++;
    $('locked-groups').insertAdjacentHTML('beforeend', groupBoxHTML(state.groupsShown, c));
    state.currentCounts = {h:0,t:0,o:0};
    $('dropzone').innerHTML='';
    $('dropzone').classList.add('empty');
    updateCountsLine();
    updateGroupCounter();
    $('hint-msg').style.color = 'var(--mint-deep)';
    $('hint-msg').textContent = '잘했어요! 정확한 묶음이에요 🎉';
    if(state.groupsShown >= state.small){
      hide($('active-group-area'));
      $('palette').style.opacity='0.4';
      $('palette').style.pointerEvents='none';
      computeRegroup();
      mergeAllGroups();
      show($('regroup-area'));
      enableRegroupInteraction();
      showFinalAnswerPrompt();
    }
  } else {
    const wrong = [];
    if(c.h!==target.h) wrong.push('백 모형');
    if(c.t!==target.t) wrong.push('십 모형');
    if(c.o!==target.o) wrong.push('일 모형');
    $('hint-msg').style.color = 'var(--coral-deep)';
    $('hint-msg').textContent = `다시 확인해보세요! (${wrong.join(', ')} 개수가 달라요)`;
  }
};

function computeRegroup(){
  const d = digits(state.big);
  const mult = state.small;
  let totalOnes = d.o*mult;
  let carry1 = Math.floor(totalOnes/10), remOnes = totalOnes%10;
  let tensAfter = d.t*mult + carry1;
  let carry2 = Math.floor(tensAfter/10), remTens = tensAfter%10;
  let hundredsAfter = d.h*mult + carry2;
  let carry3 = Math.floor(hundredsAfter/10), remHundreds = hundredsAfter%10;
  let thousands = carry3;
  const final = thousands*1000 + remHundreds*100 + remTens*10 + remOnes;
  state.regroup = {totalOnes,carry1,remOnes,tensAfter,carry2,remTens,hundredsAfter,carry3,remHundreds,thousands,final};
}

/* ---------- 클릭으로 올림(정리)하기 ---------- */
function makeSelectable(el, type){
  el.classList.add('selectable');
  el.dataset.btype = type;
  el.onclick = ()=> toggleSelect(el, type);
}

function updateSelectionHint(){
  if(!state.selection){ $('regroup-sel-count').textContent=''; return; }
  const s = state.selection;
  $('regroup-sel-count').textContent = `선택됨: 일 ${s.o.length}/10 · 십 ${s.t.length}/10 · 백 ${s.h.length}/10`;
}

function toggleSelect(el, type){
  const arr = state.selection[type];
  const idx = arr.indexOf(el);
  if(idx>=0){
    arr.splice(idx,1);
    el.classList.remove('selected');
  } else {
    el.classList.add('selected');
    arr.push(el);
  }
  updateSelectionHint();
  if(arr.length === 10){
    regroupType(type);
  }
}

function blockThousandEl(){
  const el = document.createElement('div');
  el.className = 'block-thousand';
  el.textContent = '1000';
  return el;
}

function regroupType(type){
  const els = state.selection[type].slice();
  els.forEach(e=> e.remove());
  state.selection[type] = [];
  const msg = $('regroup-msg');
  msg.style.color = 'var(--mint-deep)';
  if(type==='o'){
    const ten = blockEl('t');
    makeSelectable(ten,'t');
    ten.classList.add('regrouped-new');
    $('merged-t-row').appendChild(ten);
    msg.textContent = '일 모형 10개가 십 모형 1개로 바뀌었어요! 🔄';
  } else if(type==='t'){
    const hundred = blockEl('h');
    makeSelectable(hundred,'h');
    hundred.classList.add('regrouped-new');
    $('merged-h-row').appendChild(hundred);
    msg.textContent = '십 모형 10개가 백 모형 1개로 바뀌었어요! 🔄';
  } else if(type==='h'){
    const thousand = blockThousandEl();
    thousand.classList.add('regrouped-new');
    $('merged-th-row').appendChild(thousand);
    msg.textContent = '백 모형 10개가 천 모형 1개로 바뀌었어요! 🔄';
  }
  updateSelectionHint();
}

function enableRegroupInteraction(){
  document.querySelectorAll('#locked-groups .block-one').forEach(el=> makeSelectable(el,'o'));
  document.querySelectorAll('#locked-groups .block-ten').forEach(el=> makeSelectable(el,'t'));
  document.querySelectorAll('#locked-groups .block-hundred').forEach(el=> makeSelectable(el,'h'));
  updateSelectionHint();
}

function showFinalAnswerPrompt(){
  show($('final-answer-area'));
  $('in-final-answer').value = '';
  $('in-final-answer').focus();
  $('final-feedback').className = 'final-feedback';
  $('final-feedback').textContent = '';
}

$('btn-check-final').onclick = ()=>{
  const val = parseInt($('in-final-answer').value);
  state.finalAttempts++;
  const fb = $('final-feedback');
  if(isNaN(val)){
    fb.className = 'final-feedback bad';
    fb.textContent = '숫자를 입력해 주세요.';
    return;
  }
  state.finalAnswer = val;
  if(val === state.regroup.final){
    state.finalCorrect = true;
    fb.className = 'final-feedback ok';
    fb.textContent = `정답이에요! 🎉 수모형이 나타내는 수는 ${val}입니다.`;
    $('in-final-answer').disabled = true;
    $('btn-check-final').disabled = true;
    revealTally();
  } else {
    state.finalCorrect = false;
    fb.className = 'final-feedback bad';
    fb.textContent = '다시 한 번 모형을 세어보고 써 보세요!';
  }
};

function revealTally(){
  const d = digits(state.big);
  const mult = state.small;
  const r = state.regroup;
  let html = `<div class="tally-box">
    <div class="tally-line">🔴 일 모형: ${d.o} × ${mult} = <b>${r.totalOnes}개</b> → 십 모형 ${r.carry1}개 + 일 모형 ${r.remOnes}개</div>
    <div class="tally-line">🟢 십 모형: ${d.t} × ${mult} = ${d.t*mult}개 + (받아온 ${r.carry1}개) = <b>${r.tensAfter}개</b> → 백 모형 ${r.carry2}개 + 십 모형 ${r.remTens}개</div>
    <div class="tally-line">🟣 백 모형: ${d.h} × ${mult} = ${d.h*mult}개 + (받아온 ${r.carry2}개) = <b>${r.hundredsAfter}개</b> → 천 모형 ${r.carry3}개 + 백 모형 ${r.remHundreds}개</div>
    <div class="tally-final">➡ 정리하면: ${r.final}</div>
  </div>`;
  $('tally-area').innerHTML = html;
  $('btn-step2-next').disabled = false;
}

$('btn-step2-next').onclick = ()=> goToStep(3);

/* ---------- STEP 3 : drawing pad ---------- */
let ctx=null, isDrawing=false, currentColor='#2D2A3E', currentSize=4, isEraser=false, hasDrawn=false;
const PEN_COLORS = ['#2D2A3E','#3B5BDB','#E24F72'];

function buildGuideHTML(big, small){
  const d = digits(big);
  return `
    <div class="guide-num" style="left:90px; top:14px;">${d.h}</div>
    <div class="guide-num" style="left:146px; top:14px;">${d.t}</div>
    <div class="guide-num" style="left:202px; top:14px;">${d.o}</div>
    <div class="guide-op" style="left:20px; top:58px;">×</div>
    <div class="guide-num" style="left:202px; top:58px;">${small}</div>
    <div class="guide-line" style="top:96px;"></div>
  `;
}

function buildStep3(){
  hasDrawn = false;
  isEraser = false;
  currentColor = PEN_COLORS[0];
  currentSize = 4;
  $('btn-submit').disabled = true;

  $('guide-layer').innerHTML = `<canvas id="draw-canvas" class="draw-canvas" width="264" height="230"></canvas>`;

  let toolbarHTML = '<div style="display:flex;gap:8px;align-items:center;">';
  PEN_COLORS.forEach((c,i)=>{
    toolbarHTML += `<button class="swatch ${i===0?'active':''}" data-color="${c}" style="background:${c};"></button>`;
  });
  toolbarHTML += '</div>';
  toolbarHTML += `
    <button class="tool-btn active" id="tool-thin">얇게</button>
    <button class="tool-btn" id="tool-thick">굵게</button>
    <button class="tool-btn" id="tool-eraser">지우개 🧽</button>
    <button class="tool-btn" id="tool-clear">전체 지우기 🗑</button>
  `;
  $('pen-toolbar').innerHTML = toolbarHTML;

  document.querySelectorAll('.swatch').forEach(sw=>{
    sw.onclick = ()=>{
      document.querySelectorAll('.swatch').forEach(s=>s.classList.remove('active'));
      sw.classList.add('active');
      currentColor = sw.dataset.color;
      isEraser = false;
      $('tool-eraser').classList.remove('active');
    };
  });
  $('tool-thin').onclick = ()=>{ currentSize=4; $('tool-thin').classList.add('active'); $('tool-thick').classList.remove('active'); };
  $('tool-thick').onclick = ()=>{ currentSize=9; $('tool-thick').classList.add('active'); $('tool-thin').classList.remove('active'); };
  $('tool-eraser').onclick = ()=>{
    isEraser = !isEraser;
    $('tool-eraser').classList.toggle('active', isEraser);
  };
  $('tool-clear').onclick = ()=>{
    const canvas = $('draw-canvas');
    ctx.clearRect(0,0,canvas.width,canvas.height);
    hasDrawn = false;
    $('btn-submit').disabled = true;
  };

  setupCanvas();
}

function setupCanvas(){
  const canvas = $('draw-canvas');
  ctx = canvas.getContext('2d');
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';

  function getPos(e){
    const rect = canvas.getBoundingClientRect();
    return {
      x: (e.clientX-rect.left) * (canvas.width/rect.width),
      y: (e.clientY-rect.top) * (canvas.height/rect.height)
    };
  }

  canvas.onpointerdown = (e)=>{
    isDrawing = true;
    const pos = getPos(e);
    ctx.beginPath();
    ctx.moveTo(pos.x,pos.y);
    e.preventDefault();
  };
  canvas.onpointermove = (e)=>{
    if(!isDrawing) return;
    const pos = getPos(e);
    ctx.lineWidth = currentSize;
    ctx.strokeStyle = currentColor;
    ctx.globalCompositeOperation = isEraser ? 'destination-out' : 'source-over';
    ctx.lineTo(pos.x,pos.y);
    ctx.stroke();
    hasDrawn = true;
    $('btn-submit').disabled = false;
    e.preventDefault();
  };
  canvas.onpointerup = ()=>{ isDrawing=false; };
  canvas.onpointerleave = ()=>{ isDrawing=false; };
  canvas.onpointercancel = ()=>{ isDrawing=false; };
}

$('btn-submit').onclick = async ()=>{
  await submitResponse();
};

/* ---------- SUBMIT ---------- */
async function submitResponse(){
  const btn = $('btn-submit');
  btn.disabled = true;
  const original = btn.textContent;
  btn.textContent = '저장 중...';
  try{
    if(!window.fbSaveResponse){
      throw new Error('저장 기능을 사용할 수 없어요. 페이지를 새로고침한 뒤 다시 시도해 주세요. (Firebase 설정을 확인해 주세요)');
    }
    const canvas = $('draw-canvas');
    if(!canvas){
      throw new Error('그림판을 찾을 수 없어요. 3단계 화면을 다시 열어 주세요.');
    }
    let drawingDataUrl;
    try{
      drawingDataUrl = canvas.toDataURL('image/png');
    }catch(canvasErr){
      throw new Error('그림을 저장하는 중 문제가 생겼어요: ' + canvasErr.message);
    }
    const record = {
      lesson: 2,
      grade: state.grade, cls: state.cls, number: state.number, studentId: state.studentId,
      problem: { big: state.big, small: state.small, expected: state.expected },
      step2: { groupsShown: state.groupsShown, regroup: state.regroup, finalAnswer: state.finalAnswer, finalCorrect: state.finalCorrect, finalAttempts: state.finalAttempts },
      step3: { drawingDataUrl: drawingDataUrl, canvasWidth: canvas.width, canvasHeight: canvas.height },
      submittedAt: new Date().toISOString()
    };
    await window.fbSaveResponse(record);
    $('done-msg').textContent = `${state.grade}학년 ${state.cls}반 ${state.number}번 학생, ${state.big} × ${state.small} 문제를 잘 풀었어요!`;
    goToStep('done');
  }catch(e){
    alert('저장 중 오류가 발생했어요: ' + e.message);
    btn.disabled=false; btn.textContent=original;
  }
}
$('btn-restart').onclick = ()=>{
  state.big=null; state.small=null; state.expected=null;
  goToStep(1);
};

