    authDomain: "math-2bd03.firebaseapp.com",
    projectId: "math-2bd03",
    storageBucket: "math-2bd03.firebasestorage.app",
    messagingSenderId: "1040460930488",
    appId: "1:1040460930488:web:dda3ba7aeeafa9629cc34d"
  };

  const COLLECTION_NAME = "gem_multiplication_responses";

  let db = null;
  let auth = null;
  try{
    const app = initializeApp(firebaseConfig);
    db = getFirestore(app);
    auth = getAuth(app);
  }catch(e){
    console.error("Firebase 초기화 실패:", e);
  }

  window.fbCurrentUid = null;
  let resolveAuthReady;
  const authReadyPromise = new Promise(resolve => { resolveAuthReady = resolve; });

  if(auth){
    onAuthStateChanged(auth, (user)=>{
      window.fbCurrentUid = user ? user.uid : null;
      resolveAuthReady(window.fbCurrentUid);
    });
    signInAnonymously(auth).catch(e=>{
      console.error("익명 로그인 실패:", e);
      resolveAuthReady(null);
    });
  } else {
    resolveAuthReady(null);
  }

  window.fbWaitForAuth = () => authReadyPromise;

  window.fbSaveResponse = async function(record){
    if(!db) throw new Error("Firebase 설정이 올바르지 않아요. firebaseConfig 값을 확인해 주세요.");
    await authReadyPromise;
    const docRef = await addDoc(collection(db, COLLECTION_NAME), {
      ...record,
      uid: window.fbCurrentUid || null,
      savedAt: serverTimestamp()
    });
    return docRef.id;
