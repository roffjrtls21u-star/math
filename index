$('btn-refresh').onclick = loadTeacherData;

async function loadTeacherData(){
  $('t-list').innerHTML = '<div class="center" style="padding:20px;color:var(--ink-soft);">불러오는 중<span class="loading-dot">...</span></div>';
  try{
    if(!window.fbGetAllResponses){
      throw new Error('Firebase 설정을 확인해 주세요.');
    }
    const all = await window.fbGetAllResponses();
    const records = all.filter(r => r.lesson === 2);
    if(records.length===0){
      $('t-list').innerHTML = '<div class="center" style="padding:20px;color:var(--ink-soft);">아직 제출된 응답이 없어요.</div>';
      $('t-count').textContent = '0명 제출';
      return;
    }
    records.sort((a,b)=>{
      if(a.grade!==b.grade) return a.grade-b.grade;
      if(a.cls!==b.cls) return a.cls-b.cls;
      if(a.number!==b.number) return a.number-b.number;
      return (a.submittedAt||'').localeCompare(b.submittedAt||'');
    });
    window.__teacherRecords = records;
    $('t-count').textContent = `${records.length}건 제출 (학생 ${new Set(records.map(r=>r.studentId)).size}명)`;
    $('t-list').innerHTML = records.map(recordHTML).join('');
  }catch(e){
    $('t-list').innerHTML = `<div class="center" style="padding:20px;color:var(--coral-deep);">불러오기 오류: ${e.message}</div>`;
  }
}
function recordHTML(r){
  const time = r.submittedAt ? new Date(r.submittedAt).toLocaleString('ko-KR') : '';
  const cw = (r.step3 && r.step3.canvasWidth) ? r.step3.canvasWidth : 264;
  const ch = (r.step3 && r.step3.canvasHeight) ? r.step3.canvasHeight : 230;
  const drawing = r.step3 ? r.step3.drawingDataUrl : null;
  return `<div class="t-record">
    <h4>${r.grade}학년 ${r.cls}반 ${r.number}번</h4>
    <div class="meta">${time}</div>
    <div class="field"><b>문제</b> ${r.problem.big} × ${r.problem.small} (정답: ${r.problem.expected})</div>
    <div class="field"><b>수모형으로 쓴 답</b> ${r.step2 && r.step2.finalAnswer!=null ? r.step2.finalAnswer : '-'} ${r.step2 && r.step2.finalCorrect ? '✅' : ''} (시도 ${r.step2?r.step2.finalAttempts:0}회)</div>
    <div class="field"><b>세로셈 (직접 쓴 답)</b></div>
    <div class="draw-wrap" style="margin:6px 0 0;">
      <div class="guide-layer" style="width:${cw}px;height:${ch}px;">
        ${drawing ? `<img src="${drawing}" style="position:absolute;top:0;left:0;width:100%;height:100%;">` : ''}
      </div>
    </div>
  </div>`;
}
function escapeHTML(s){
  return String(s||'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
$('btn-copy-all').onclick = async ()=>{
  const records = window.__teacherRecords || [];
  const text = records.map(r=>{
    return `${r.grade}학년 ${r.cls}반 ${r.number}번 | 문제: ${r.problem.big}×${r.problem.small}=${r.problem.expected} | 수모형 답: ${r.step2.finalAnswer}(${r.step2.finalCorrect?'정답':'오답'}) | 세로셈: (그림 응답 - 앱에서 확인)`;
  }).join('\n');
  try{
    await navigator.clipboard.writeText(text);
    alert('전체 응답이 클립보드에 복사되었어요. (그림 응답은 앱 화면에서 확인해 주세요)');
  }catch(e){
    alert('클립보드 복사를 지원하지 않는 환경이에요.');
  }
};
